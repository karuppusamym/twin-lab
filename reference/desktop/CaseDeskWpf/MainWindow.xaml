<!-- Main window: menu, search box, grid of cases, status bar. -->
<Window x:Class="CaseDeskWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="MainForm"
        Title="CaseDesk - Cases" Width="610" Height="380" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu x:Name="menuMain" DockPanel.Dock="Top">
            <MenuItem x:Name="mnuFile" Header="_File">
                <MenuItem x:Name="mnuExit" Header="E_xit" Click="Exit" />
            </MenuItem>
            <MenuItem x:Name="mnuCase" Header="_Case">
                <MenuItem x:Name="mnuOpenCase" Header="_Open case" InputGestureText="Ctrl+O"
                          Click="OpenCase" />
                <MenuItem x:Name="mnuRefresh" Header="_Refresh" InputGestureText="F5"
                          Click="Refresh" />
            </MenuItem>
            <MenuItem x:Name="mnuHelp" Header="_Help">
                <MenuItem x:Name="mnuAbout" Header="_About CaseDesk" Click="About" />
            </MenuItem>
        </Menu>
        <StatusBar x:Name="statusMain" DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="lblCount" />
            </StatusBarItem>
        </StatusBar>
        <StackPanel x:Name="pnlSearch" DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10,12,8">
            <Label x:Name="lblSearch" Content="Case or _name" Width="86"
                   Target="{Binding ElementName=txtSearch}" VerticalAlignment="Center" />
            <TextBox x:Name="txtSearch" Width="220" Height="23" TabIndex="1" />
            <Button x:Name="btnSearch" Content="_Search" Width="80" Height="25" Margin="10,0,0,0"
                    TabIndex="2" IsDefault="True" Click="Search" />
            <Button x:Name="btnOpen" Content="_Open" Width="80" Height="25" Margin="10,0,0,0"
                    TabIndex="3" Click="OpenCase" />
        </StackPanel>
        <DataGrid x:Name="dgvCases" Margin="12,0,12,8" TabIndex="4" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  MouseDoubleClick="RowDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Case No" Binding="{Binding CaseNo}" Width="*" />
                <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                <DataGridTextColumn Header="Opened" Binding="{Binding Opened}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
